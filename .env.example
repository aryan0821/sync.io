# Slack Bot Configuration
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_BOT_USER_ID=U1234567890

# GitHub Configuration
GITHUB_TOKEN=ghp_your_github_token
GITHUB_OWNER=your-username
GITHUB_REPO=your-repo-name

# GitHub Webhooks (Optional)
SLACK_USER_ID=U1234567890
GITHUB_USERNAME=your-github-username
WEBHOOK_PORT=3000

# OpenAI Configuration (Optional but recommended for better question understanding)
OPENAI_API_KEY=sk-your-openai-api-key

# ==========================================
# Email Forwarding Configuration (Optional)
# ==========================================

# Outlook/Microsoft 365 Configuration
# Follow the setup guide in README to create an Azure AD app registration
OUTLOOK_CLIENT_ID=your-azure-app-client-id
OUTLOOK_CLIENT_SECRET=your-azure-app-client-secret
OUTLOOK_TENANT_ID=your-azure-tenant-id
OUTLOOK_USER_EMAIL=your-email@company.com

# Claude API Configuration
# Get your API key from https://console.anthropic.com/
CLAUDE_API_KEY=sk-ant-your-claude-api-key

# Slack Email Configuration
# Get your Slack workspace email from Slack > Settings > Incoming Email
SLACK_EMAIL=your-channel@yourworkspace.slack.com

# SMTP Configuration for Forwarding
# For Outlook/Office 365:
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=your-email@company.com
SMTP_PASS=your-email-password-or-app-password
FROM_EMAIL=your-email@company.com

# Email Processing Settings
# Cron schedule for checking emails (default: every 5 minutes)
# Format: minute hour day-of-month month day-of-week
# Examples:
#   */5 * * * *  - Every 5 minutes
#   */10 * * * * - Every 10 minutes
#   0 * * * *    - Every hour
#   0 9-17 * * 1-5 - Every hour from 9am-5pm on weekdays
EMAIL_CHECK_INTERVAL=*/5 * * * *

# Confidence threshold for forwarding (0.0-1.0, default: 0.6)
# Higher = more strict filtering
CONFIDENCE_THRESHOLD=0.6
